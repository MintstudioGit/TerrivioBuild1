# Terrivio — Environment Variables
# Copy this file to .env.local (for local dev) and set values in your Supabase Dashboard for production.

# ─────────────────────────────────────────────
# ANALYTICS & ERROR TRACKING  (frontend, set in Vercel env vars too)
# ─────────────────────────────────────────────

# PostHog — https://posthog.com (free: 1M events/month)
# Leave blank to disable analytics in local dev
VITE_POSTHOG_KEY=phc_...
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Sentry — https://sentry.io (free: 5k errors/month)
# Leave blank to disable error reporting in local dev
VITE_SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/xxx

# ─────────────────────────────────────────────
# AI PREVIEW  (Phase 2.5 — optional but recommended)
# https://platform.openai.com/api-keys
# Free tier: $5 credit on new accounts
# Free plan: 3 previews/day (gpt-4o-mini)
# Pro plan:  unlimited previews + GPT-4o / GPT-4 Turbo
# ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─────────────────────────────────────────────
# SUPABASE  (auto-set on Supabase Edge Functions)
# ─────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ─────────────────────────────────────────────
# STRIPE
# https://dashboard.stripe.com/apikeys
# https://dashboard.stripe.com/products
# ─────────────────────────────────────────────

# 0.1  Secret key — use sk_test_... for smoke tests, sk_live_... for production
STRIPE_SECRET_KEY=sk_live_...

# 0.2  Price ID from the product you create in the Stripe Dashboard
#      Intro price:  €9/mo  → price_INTRO
#      Standard:    €39/mo  → price_PRO
STRIPE_PRICE_ID=price_...

# 0.3  Webhook signing secret — from:
#      Stripe Dashboard → Developers → Webhooks → Add endpoint
#      Endpoint URL: https://YOUR_PROJECT_ID.supabase.co/functions/v1/make-server-a2b5dce9/stripe-webhook
#      Event to listen for: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_...

# ─────────────────────────────────────────────
# RESEND  (contact form)
# https://resend.com/api-keys
# Free tier: 3,000 emails/month, 100/day
# ─────────────────────────────────────────────
RESEND_API_KEY=re_...

# Email address that receives contact form submissions
CONTACT_EMAIL=hello@terrivio.com

# ─────────────────────────────────────────────
# SITE
# ─────────────────────────────────────────────
SITE_URL=https://terrivio.com

# Allowed CORS origin — restricts who can call the Edge Functions API
# Defaults to https://terrivio.com; add a staging URL here if needed
ALLOWED_ORIGIN=https://terrivio.com
